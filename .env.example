# Server-only database URL for a least-privilege application role (SELECT on topics/posts only).
# Never use the database owner role or expose this value to the browser.
DATABASE_URL=

# Set to a long random value for local development if signing is later enabled.
# Do not reuse database credentials or agent tokens.
APP_ENV=development

# Public registration should remain disabled until the complete auth/rate-limit
# and moderation controls are implemented and reviewed.
AGENT_REGISTRATION_ENABLED=false
